# Environment Configuration Template for STP CHICKENS (Thangam Farms 2.0)

# 1. Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# 2. Database & Storage Configuration
# Set to 'mongodb' to use MongoDB Atlas, or 'json' for local disk-based persistence
STORAGE_MODE=mongodb

# MongoDB Atlas URI (Provide valid cluster credentials)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/thangam_farms?retryWrites=true&w=majority
MONGO_DB_NAME=thangam_farms

# Local Storage Directory (Used when STORAGE_MODE=json or during fallback)
DATA_DIR=data

# 3. Security, Sessions & JWT
# Minimum 32-character high-entropy secret string
JWT_SECRET=replace_with_a_secure_random_secret_key_at_least_32_characters
JWT_EXPIRES_IN=7d
COOKIE_SECRET=replace_with_a_secure_cookie_secret_key

# 4. Operations & Contact Information (Verified Business Facts)
BUSINESS_PHONE=+919965160358
WHATSAPP_NUMBER=919965160358
FACILITY_COORDINATES_LAT=11.0050
FACILITY_COORDINATES_LNG=77.1013

# 5. Optional External AI & Voice Providers (Bilingual Assistant)
# The assistant works autonomously using built-in verified knowledge.
# If provided, Gemini or OpenAI will be utilized for advanced dynamic conversational expansion.
GEMINI_API_KEY=
OPENAI_API_KEY=
